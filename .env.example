# Copy to .env and fill in. Everything here is optional for a local run
# except JWT_SECRET, which you should always set.

# 32+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Hosted providers, all optional. Leave blank and they show up as
# "not configured"; the app still works on Ollama.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider new requests go to, and what to fall back to. Reviews run on the
# local Ollama model; if it fails or is too slow to start, DeepSeek takes over.
# The fallback can be an ordered list, and plans that don't include a provider
# skip it (Free stays on Ollama).
AGENT__DEFAULT_PROVIDER=ollama
# AGENT__FALLBACK_PROVIDER=deepseek

# Route Claude through a gateway (LiteLLM, corporate proxy) instead of
# api.anthropic.com. It must accept POST {base}/v1/messages with x-api-key.
# PROVIDERS__ANTHROPIC__BASE_URL=https://your-gateway.example.com
# PROVIDERS__ANTHROPIC__MODEL=claude-sonnet-5
# DeepSeek model: deepseek-flash (default) or deepseek-v4-pro.
# PROVIDERS__DEEPSEEK__MODEL=deepseek-flash
# How long a provider gets to send its first token before the next one takes over.
# AGENT__FIRST_TOKEN_TIMEOUT_SECONDS=25

# Local models (docker-compose passes these through)
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Use an Ollama that's already running on your machine instead of the container:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# How long Ollama keeps the model in memory, and its context window in tokens.
# OLLAMA_KEEP_ALIVE=24h
# OLLAMA_CONTEXT_LENGTH=8192

# "production" turns on the strict start-up checks (real JWT secret, no default
# database password, no self-serve plan changes).
# APP_ENVIRONMENT=development

# Postgres credentials for docker-compose. Production refuses the app:app default.
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=diffsage

# Running the backend outside docker (make dev-backend) needs these too:
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/diffsage
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333

# Any settings.toml value can be overridden as SECTION__KEY, for example:
# RATE_LIMITS__AGENT__LIMIT=40
# BILLING__ALLOW_SELF_SERVE_PLAN_CHANGE=false

# Port for the web app. Change it if something else already uses 8080.
# WEB_PORT=8080
# Host port for the API (health, docs). Change it if something else uses 8000.
# API_PORT=8000
# Host port for the Ollama container. Change it if the Windows Ollama app already uses 11434.
# OLLAMA_PORT=11434
